{
  "color": {
    "brand": {
      "graphite": "#141618",
      "carbon": "#292D32",
      "signal": "#E6FF52",
      "chalk": "#F3F2ED",
      "steel": "#8C959F"
    },
    "neutral": {
      "100": "#EAE8E2",
      "200": "#C1C6CC",
      "500": "#66717C",
      "600": "#515B65",
      "750": "#3A4148"
    },
    "interaction": {
      "signal-hover": "#D9F143",
      "signal-pressed": "#C7DD3B",
      "link-light": "#425200"
    },
    "status": {
      "light": {
        "success": "#225B38",
        "warning": "#795005",
        "error": "#9A322B",
        "info": "#255A79"
      },
      "dark": {
        "success": "#9DD7AD",
        "warning": "#F4CB76",
        "error": "#FFABA4",
        "info": "#A9D0EA"
      }
    }
  },
  "theme": {
    "light": {
      "canvas": "{color.brand.chalk}",
      "surface": "{color.neutral.100}",
      "text": "{color.brand.graphite}",
      "text-secondary": "{color.neutral.600}",
      "border": "{color.neutral.200}",
      "border-control": "{color.neutral.500}",
      "link": "{color.interaction.link-light}",
      "focus": "{color.brand.graphite}",
      "action": "{color.brand.signal}",
      "action-hover": "{color.interaction.signal-hover}",
      "action-pressed": "{color.interaction.signal-pressed}",
      "on-action": "{color.brand.graphite}",
      "success": "{color.status.light.success}",
      "warning": "{color.status.light.warning}",
      "error": "{color.status.light.error}",
      "info": "{color.status.light.info}"
    },
    "dark": {
      "canvas": "{color.brand.graphite}",
      "surface": "{color.brand.carbon}",
      "text": "{color.brand.chalk}",
      "text-secondary": "{color.brand.steel}",
      "border": "{color.neutral.750}",
      "border-control": "{color.brand.steel}",
      "link": "{color.brand.signal}",
      "focus": "{color.brand.signal}",
      "action": "{color.brand.signal}",
      "action-hover": "{color.interaction.signal-hover}",
      "action-pressed": "{color.interaction.signal-pressed}",
      "on-action": "{color.brand.graphite}",
      "success": "{color.status.dark.success}",
      "warning": "{color.status.dark.warning}",
      "error": "{color.status.dark.error}",
      "info": "{color.status.dark.info}"
    }
  },
  "font": {
    "family": {
      "sans": ["Instrument Sans", "system-ui", "sans-serif"],
      "mono": ["IBM Plex Mono", "ui-monospace", "monospace"]
    },
    "size": {
      "metadata": "0.8125rem",
      "code": "0.875rem",
      "body": "1rem",
      "title": "1.75rem",
      "display": "2.5rem"
    },
    "weight": {
      "regular": 400,
      "semibold": 600
    },
    "leading": {
      "tight": 1.15,
      "normal": 1.5
    }
  },
  "space": {
    "1": "0.25rem",
    "2": "0.5rem",
    "3": "0.75rem",
    "4": "1rem",
    "6": "1.5rem",
    "8": "2rem",
    "12": "3rem",
    "16": "4rem"
  },
  "radius": {
    "none": "0",
    "control": "0.25rem"
  },
  "border": {
    "width": "1px",
    "focus-width": "2px",
    "focus-offset": "2px"
  }
}
